# Copy to .env on your VPS only. chmod 600 .env. Never commit real values.
DOMAIN=oura.example.com
LOGIN_USER=pearl
# Use a single-quoted bcrypt hash so Compose does not interpolate its $ signs.
LOGIN_HASH='$2a$14$REPLACE_WITH_CADDY_HASH_PASSWORD_OUTPUT'
IRON_PROXY_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
# Leave disabled until the selected AI provider is configured and explicitly approved.
IRON_SCHEDULE_ENABLED=0
IRON_SCHEDULE_AI=0
IRON_SCHEDULE_AI_PROVIDER=

# Wake means Oura main-sleep/readiness data ready, not a real-time awake event.
IRON_SCHEDULE_MODE=wake
IRON_WAKE_POLL_SECONDS=900
IRON_WAKE_STABLE_SECONDS=900
